{
  "name": "mascaras-vs-cabelleras-tcg",
  "version": "1.0.0",
  "description": "Sitio web y catálogo interactivo para Máscaras vs Cabelleras TCG",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --base-href /MvC.TCG/",
    "deploy": "ng build --base-href /MvC.TCG/ && npx -y angular-cli-ghpages --dir=dist/mvc-tcg/browser",
    "watch": "ng build --watch --configuration development",
    "sync-data": "python scripts/build_data.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.0",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/forms": "^19.1.0",
    "@angular/platform-browser": "^19.1.0",
    "@angular/router": "^19.1.0",
    "lucide-angular": "^0.475.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.1.0",
    "@angular/cli": "^19.1.0",
    "@angular/compiler-cli": "^19.1.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.6.2"
  }
}
